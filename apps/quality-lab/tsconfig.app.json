{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "paths": {},
    "types": ["node", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts"]
  },
  "exclude": ["**/*.spec.*", "**/*.test.*", "src/test/**", "vite.config.*", "vitest.config.*"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
