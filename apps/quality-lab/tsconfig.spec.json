{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "paths": {},
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
