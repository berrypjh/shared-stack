{
  "extends": "../../tsconfig.lib.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "tsBuildInfoFile": "out-tsc/jest/.tsbuildinfo",
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.d.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
