{
  "extends": "../../tsconfig.lib.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc",
    "rootDir": "./src",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.*",
    "**/*.test.*",
    "src/test-setup.ts",
    "eslint.config.*"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../ui-core/tsconfig.lib.json"
    }
  ]
}
