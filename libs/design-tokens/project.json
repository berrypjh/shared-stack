{
  "name": "@berrypjh/design-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-tokens/src",
  "projectType": "library",
  "targets": {
    "build:tokens": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx libs/design-tokens/src/build.ts"
      }
    },
    "build:ts": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:tokens"],
      "options": {
        "command": "tsc -p libs/design-tokens/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:tokens", "build:ts"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:ts"],
      "options": {
        "command": "tsc -p libs/design-tokens/tsconfig.spec.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["build"],
      "options": {
        "configFile": "libs/design-tokens/vitest.config.mts",
        "watch": false,
        "reportsDirectory": "libs/design-tokens/test-output/vitest/coverage"
      },
      "configurations": {
        "ci": {
          "runMode": "run"
        }
      }
    }
  },
  "tags": ["scope:internal"]
}
