{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["vitest.config.*", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["src/.generated/**"]
}
