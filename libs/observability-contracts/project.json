{
  "name": "@berrypjh/observability-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/observability-contracts/src",
  "tags": ["scope:internal"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": ["rm -rf dist", "tsc -p tsconfig.lib.json"],
        "parallel": false,
        "cwd": "libs/observability-contracts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "parallel": false,
        "cwd": "libs/observability-contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "libs/observability-contracts"
      }
    }
  }
}
