{
  "name": "@berrypjh/react-ui",
  "projectType": "library",
  "sourceRoot": "libs/react-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "parallel": false,
        "commands": [
          "nx run @berrypjh/react-ui:build-js",
          "nx run @berrypjh/react-ui:build-types",
          "nx run @berrypjh/react-ui:generate-catalog",
          "nx run @berrypjh/react-ui:build-cli"
        ]
      }
    },
    "build-js": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "nx run @berrypjh/react-ui:bundle-js",
          "find libs/react-ui/dist -type f \\( -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete",
          "rm -rf libs/react-ui/dist/src",
          "node -e \"const fs=require('fs'); const tokens=fs.readFileSync('libs/ui-core/dist/css/index.css','utf8'); const styles=fs.readFileSync('libs/react-ui/dist/index.css','utf8'); fs.writeFileSync('libs/react-ui/dist/index.css', tokens+'\\n'+styles);\"",
          "cp libs/ui-core/dist/tailwind.js libs/react-ui/dist/tailwind.js",
          "cp libs/ui-core/dist/tailwind.d.ts libs/react-ui/dist/tailwind.d.ts",
          "cp libs/ui-core/dist/tokens.json libs/react-ui/dist/tokens.json",
          "cp libs/react-ui/AGENTS.consumer.md libs/react-ui/dist/AGENTS.md",
          "node -e \"const fs=require('fs'); const p='libs/react-ui/dist/package.json'; const j=JSON.parse(fs.readFileSync(p,'utf8')); delete j.exports; delete j.devDependencies; fs.writeFileSync(p, JSON.stringify(j,null,2));\""
        ],
        "parallel": false
      }
    },
    "bundle-js": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "libs/react-ui/src/index.ts",
        "outputPath": "libs/react-ui/dist",
        "tsConfig": "libs/react-ui/tsconfig.rollup.json",
        "compiler": "swc",
        "format": ["esm"],
        "outputFileName": "index",
        "extractCss": "index.css",
        "external": ["react", "react-dom", "react/jsx-runtime"],
        "assets": [
          {
            "input": "libs/react-ui",
            "output": ".",
            "glob": "README.md"
          }
        ],
        "rollupConfig": "libs/react-ui/rollup.config.cjs",
        "skipTypeCheck": true
      }
    },
    "build-types": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/types"],
      "options": {
        "command": "mkdir -p libs/react-ui/dist/types && dts-bundle-generator --project libs/react-ui/tsconfig.lib.json --no-banner --no-check --external-imports=react --external-imports=react-dom --external-imports=react/jsx-runtime -o libs/react-ui/dist/types/index.d.ts libs/react-ui/src/index.ts"
      }
    },
    "generate-catalog": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/llm-catalog.json"],
      "options": {
        "command": "tsx tools/scripts/generate-consumer-catalog/index.ts --target=react-ui"
      }
    },
    "build-cli": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/cli.mjs"],
      "options": {
        "command": "esbuild tools/consumer-retrieval/package-cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=libs/react-ui/dist/cli.mjs --banner:js='#!/usr/bin/env node'"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/out-tsc"],
      "options": {
        "commands": [
          "tsc -p libs/react-ui/tsconfig.lib.json",
          "tsc -p libs/react-ui/tsconfig.storybook.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/react-ui/vitest.config.mts",
        "watch": false,
        "reportsDirectory": "libs/react-ui/test-output/vitest/coverage"
      },
      "configurations": {
        "ci": {
          "runMode": "run"
        }
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"]
    }
  }
}
