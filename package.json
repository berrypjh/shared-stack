{
  "name": "@berrypjh/shared-stack",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "build-storybook": "nx build-storybook @berrypjh/react-ui",
    "build:apps": "nx run-many -t build --projects=@berrypjh/demo-web,@berrypjh/demo-mobile",
    "build:libs": "nx run-many -t build --projects=@berrypjh/design-tokens,@berrypjh/ui-core,@berrypjh/react-ui,@berrypjh/react-native-ui",
    "build:libs:web": "nx run-many -t build --projects=@berrypjh/design-tokens,@berrypjh/ui-core,@berrypjh/react-ui",
    "build:mcp:commit": "nx run commit-mcp:build",
    "catalog:gen": "tsx tools/scripts/generate-consumer-catalog/index.ts",
    "eval:consumer:context": "tsx tools/evals/consumer/runner/run.ts --context-only",
    "eval:consumer:dev": "tsx tools/evals/consumer/runner/run.ts --split=dev",
    "eval:consumer:routing": "tsx tools/evals/consumer/runner/run.ts --routing-only",
    "eval:consumer:smoke": "tsx tools/evals/consumer/runner/run.ts --smoke --split=dev --run-id=pr-smoke",
    "eval:consumer:test": "tsx tools/evals/consumer/runner/run.ts --split=test",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "local-registry": "nx local-registry",
    "prepare": "husky install",
    "react-native-ui:measure": "MEASURE_TARGET=react-native-ui tsx --env-file-if-exists=.env tools/scripts/measure-tokens/all.ts",
    "react-ui:measure": "MEASURE_TARGET=react-ui tsx --env-file-if-exists=.env tools/scripts/measure-tokens/all.ts",
    "release:local": "tsx tools/scripts/release/release-local.ts",
    "release:npm": "tsx tools/scripts/release/release-npm.ts",
    "release:npm:beta": "tsx tools/scripts/release/release-npm.ts --beta",
    "release:npm:first-release": "tsx tools/scripts/release/release-npm.ts --first-release",
    "reset": "nx reset",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "start": "nx serve @berrypjh/demo-web",
    "start:mobile": "nx run @berrypjh/demo-mobile:start",
    "storybook": "nx storybook @berrypjh/react-ui",
    "storybook:a11y": "concurrently -k -s first -n SB,A11Y \"http-server libs/react-ui/storybook-static -p 6006 --silent\" \"wait-on tcp:6006 && test-storybook --url http://localhost:6006 --config-dir libs/react-ui/.storybook\"",
    "test": "nx run-many -t test",
    "test:ci": "nx run-many -t test --configuration=ci",
    "test:watch": "nx run-many -t test --watch",
    "tokens:build": "nx run @berrypjh/design-tokens:build",
    "tokens:clean": "rm -rf libs/design-tokens/dist libs/design-tokens/src/.generated libs/design-tokens/tsconfig.lib.tsbuildinfo",
    "tokens:gen": "nx run @berrypjh/design-tokens:build:tokens",
    "tokens:measure": "tsx --env-file-if-exists=.env tools/scripts/measure-tokens/all.ts",
    "tokens:watch": "nx watch --projects=@berrypjh/design-tokens -- nx run @berrypjh/design-tokens:build:tokens",
    "tools:check": "tsc -p tools/tsconfig.json && vitest run --config tools/vitest.tools.config.mts",
    "treeshake": "tsx tools/scripts/treeshake/check.ts",
    "typecheck": "nx run-many -t typecheck",
    "ui-core:measure": "MEASURE_TARGET=ui-core tsx --env-file-if-exists=.env tools/scripts/measure-tokens/all.ts",
    "ui:lookup": "tsx tools/consumer-retrieval/cli.ts"
  },
  "private": true,
  "prettier": "@berrypjh/prettier-config",
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-react": "^7.14.5",
    "@babel/runtime": "~7.27.6",
    "@berrypjh/commitlint-config": "workspace:^",
    "@berrypjh/design-tokens": "workspace:*",
    "@berrypjh/eslint-config": "workspace:^",
    "@berrypjh/prettier-config": "workspace:^",
    "@berrypjh/tsconfig": "workspace:^",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.8.0",
    "@expo/cli": "~54.0.16",
    "@nx/devkit": "^22.7.0",
    "@nx/eslint": "^22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/expo": "^22.3.3",
    "@nx/jest": "^22.3.3",
    "@nx/js": "22.3.3",
    "@nx/playwright": "^22.3.3",
    "@nx/react": "^22.3.3",
    "@nx/react-native": "^22.3.3",
    "@nx/rollup": "22.3.3",
    "@nx/storybook": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/web": "^22.3.3",
    "@playwright/test": "^1.49.0",
    "@react-native-community/cli": "~18.0.0",
    "@react-native-community/cli-platform-android": "~18.0.0",
    "@react-native-community/cli-platform-ios": "~18.0.0",
    "@react-native/babel-preset": "~0.81.5",
    "@react-native/metro-config": "~0.79.3",
    "@rollup/plugin-url": "^8.0.2",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/react": "10.2.19",
    "@storybook/react-vite": "10.2.19",
    "@storybook/test-runner": "0.24.3",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.15.33",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/react-native": "^14.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.0.0",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "axe-playwright": "2.2.2",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.7",
    "chromatic": "^16.5.0",
    "concurrently": "9.2.1",
    "core-js": "^3.36.1",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-storybook": "^10.2.19",
    "eslint-plugin-unused-imports": "^4.4.1",
    "http-server": "14.1.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.4.0",
    "metro-config": "~0.83.0",
    "metro-resolver": "~0.83.0",
    "nx": "22.3.3",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "~1.5.1",
    "rollup": "^4.14.0",
    "sinon": "^21.0.2",
    "size-limit": "^12.1.0",
    "storybook": "10.2.19",
    "tailwindcss": "4.2.4",
    "test-renderer": "1.2.0",
    "tiktoken": "^1.0.22",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.0.5",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.0",
    "wait-on": "9.0.5"
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.9",
    "@expo/metro-runtime": "~6.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "expo": "~54.0.0",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "react": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,scss,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
